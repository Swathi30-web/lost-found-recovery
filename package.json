{
  "name": "lost-and-found-recovery",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:api\" \"vite\"",
    "api": "json-server --watch db.json --port 3001",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "reset-db": "cp db.seed.json db.json"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "json-server": "^0.17.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
